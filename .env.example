# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-for-local-review-only
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL
POSTGRES_DB=ravid
POSTGRES_USER=ravid
POSTGRES_PASSWORD=change-me-for-local-review-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis and Celery
REDIS_URL=redis://redis:6379/0

# Chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000

# OpenRouter free-tier answer generation. A key is required only for live chat requests.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_TITLE=RAVID Backend
OPENROUTER_APP_URL=

# Local subscription quota and bounded RAG defaults.
DEFAULT_DAILY_TOKEN_LIMIT=20000
RAG_RETRIEVAL_K=4
RAG_RETRIEVAL_SEARCH_TYPE=similarity_score_threshold
RAG_RETRIEVAL_SCORE_THRESHOLD=0.2
RAG_RETRIEVAL_FETCH_K=20
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_OUTPUT_TOKENS=800
RAG_CHAT_OVERHEAD_TOKENS=256
RAG_HYDE_MAX_OUTPUT_TOKENS=256
RAG_HYDE_MAX_OUTPUT_CHARS=2000
RAG_HYDE_TIMEOUT_MS=3000
RAG_TEMPERATURE=0
RAG_PROVIDER_TIMEOUT_MS=10000
RAG_PROVIDER_MAX_RETRIES=0

# Vector-ingestion tuning defaults.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_MB=25
VECTOR_CHUNK_SIZE=1000
VECTOR_CHUNK_OVERLAP=150

# Reviewer-friendly JWT lifetimes.
JWT_ACCESS_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Local-only Flower dashboard credentials.
FLOWER_BASIC_AUTH=ravid:change-me
