# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-for-local-review-only
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL
POSTGRES_DB=ravid
POSTGRES_USER=ravid
POSTGRES_PASSWORD=change-me-for-local-review-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis and Celery
REDIS_URL=redis://redis:6379/0

# Chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000

# OpenRouter placeholders for future answer-generation work.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto

# Vector-ingestion tuning defaults.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_MB=25
VECTOR_CHUNK_SIZE=1000
VECTOR_CHUNK_OVERLAP=150

# Reviewer-friendly JWT lifetimes.
JWT_ACCESS_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Local-only Flower dashboard credentials.
FLOWER_BASIC_AUTH=ravid:change-me
